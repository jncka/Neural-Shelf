generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ─── NextAuth Models ───────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Application Models ────────────────────────────────────────

model User {
  id              String     @id @default(cuid())
  name            String?
  email           String?    @unique
  emailVerified   DateTime?
  image           String?
  username        String?    @unique
  bio             String?
  stripeAccountId String?
  createdAt       DateTime   @default(now())
  accounts        Account[]
  sessions        Session[]
  skills          Skill[]
  reviews         Review[]
  collections     Collection[]
}

model Skill {
  id              String     @id @default(cuid())
  authorId        String
  name            String
  slug            String     @unique
  description     String
  category        String
  tags            String     @default("[]") // JSON array stored as string for SQLite
  downloadCount   Int        @default(0)
  zipUrl          String?
  previewImages   String     @default("[]") // JSON array stored as string for SQLite
  skillMdContent  String
  aiCompatibility String     @default("[]") // JSON array stored as string for SQLite
  version         String     @default("1.0.0")
  isFeatured      Boolean    @default(false)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  author          User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  reviews         Review[]

  @@index([category])
  @@index([authorId])
}

model Review {
  id        String   @id @default(cuid())
  skillId   String
  userId    String
  rating    Int
  body      String?
  createdAt DateTime @default(now())
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([skillId, userId])
}


model Collection {
  id          String   @id @default(cuid())
  curatorId   String
  title       String
  description String?
  skillIds    String   @default("[]") // JSON array stored as string for SQLite
  createdAt   DateTime @default(now())
  curator     User     @relation(fields: [curatorId], references: [id], onDelete: Cascade)
}
